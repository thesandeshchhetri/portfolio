# Copy to .env and replace all example values.
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio_app
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SESSION_SECRET=replace-with-output-from-openssl-rand-base64-48
APP_PORT=3000
SEED_DATABASE=false
