generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Ride {
  id    Int      @id @default(autoincrement())
  place String
  date  DateTime?
  km    Int?
  story String?  @db.Text
  photo String?
}

model Project {
  id    Int    @id @default(autoincrement())
  name  String
  blurb String @db.Text
  stack String
}

model Experience {
  id      Int    @id @default(autoincrement())
  title   String
  org     String
  period  String
  details String @db.Text
}

model ContentItem {
  id        Int      @id @default(autoincrement())
  category  String   @db.VarChar(40)
  title     String   @db.VarChar(180)
  subtitle  String?  @db.VarChar(240)
  body      String?  @db.Text
  tags      String?  @db.VarChar(1000)
  image     String?  @db.VarChar(500)
  href      String?  @db.VarChar(500)
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category, visible, sortOrder])
}

model SiteConfig {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}
